# VAPID Keys for Web Push Authentication
# Generate with: py-vapid --gen
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Security & Authentication
# If set, clients must provide X-API-Key header to trigger sends or manage devices
API_KEY=dev-secret-key-change-in-prod

# Database
# SQLite default: sqlite:///notifications.db
# PostgreSQL: postgresql://postgres:postgres@db:5432/notifications
DATABASE_URI=sqlite:///notifications.db

# Queue (Redis or Memory)
# Leave blank for built-in in-memory queue fallback
# In Docker: redis://redis:6379/0
REDIS_URL=

# Producer Server
PRODUCER_PORT=5000
FLASK_ENV=production
