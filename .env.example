# Push Notification API Environment Variables
# Copy this file to producer/.env and configure your values

# VAPID Keys for Web Push Authentication
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Security & Authentication
API_KEY=dev-secret-key-change-in-prod

# Database
DATABASE_URI=sqlite:///notifications.db
# DATABASE_URI=postgresql://postgres:postgres@localhost:5432/notifications

# Queue (Redis or In-Memory)
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# Producer Server
PRODUCER_PORT=5000
FLASK_ENV=development
